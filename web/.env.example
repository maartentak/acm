# Copy to .env.local (client vars) / set in your host's dashboard (server vars).

# --- Client (exposed to the browser; safe to be public) ---
# Google OAuth *Web* client ID from the Google Cloud Console. When set, the
# Calendar screen does real Google sign-in; when unset, it uses demo data.
VITE_GOOGLE_CLIENT_ID=

# --- Server (serverless function only; NEVER prefix with VITE_) ---
# Anthropic API key for LLM-powered task breakdown. When unset, the app falls
# back to the offline heuristic engine automatically.
ANTHROPIC_API_KEY=
