<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Momentum" parent="android:Theme.Material.NoActionBar" />

    <!-- Splash screen theme using androidx core-splashscreen. -->
    <style name="Theme.Momentum.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Momentum</item>
    </style>

</resources>
